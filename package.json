{
  "name": "brito",
  "version": "0.1.0",
  "description": "Coding-agent CLI with a code knowledge graph, memory and reviewable skills / CLI de agente de código com grafo de conhecimento, memória e skills revisáveis",
  "type": "module",
  "bin": {
    "brito": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "eval:learn": "tsx test/eval-learn.ts",
    "prepare": "tsc",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "latest",
    "fast-glob": "latest",
    "kuzu": "latest",
    "string-width": "^8.3.0",
    "tree-sitter-wasms": "latest",
    "web-tree-sitter": "0.24.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonbrito/brito.git"
  },
  "homepage": "https://github.com/wilsonbrito/brito#readme",
  "bugs": {
    "url": "https://github.com/wilsonbrito/brito/issues"
  },
  "author": "Wilson Brito",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    ".brito/agents",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "llm",
    "knowledge-graph",
    "code-graph",
    "mcp",
    "claude",
    "tree-sitter",
    "svelte",
    "typescript",
    "python"
  ]
}
