{
  "name": "brito-cli",
  "version": "0.7.1",
  "description": "Coding-agent CLI with a code knowledge graph, memory and reviewable skills / CLI de agente de código com grafo de conhecimento, memória e skills revisáveis",
  "type": "module",
  "bin": {
    "brito": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "eval:learn": "tsx test/eval-learn.ts",
    "prepare": "tsc",
    "prepublishOnly": "npm run typecheck && npm test",
    "desktop": "npm run build && npm run bundle && npm --prefix desktop install --no-audit --no-fund && npm --prefix desktop start",
    "bundle": "node build-bundle.mjs",
    "desktop:app": "npm run build && npm run bundle && npm --prefix desktop install --no-audit --no-fund && node desktop/package.mjs --install",
    "desktop:dmg": "npm run build && npm run bundle && npm --prefix desktop install --no-audit --no-fund && node desktop/package.mjs --dmg"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@ladybugdb/core": "0.21.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^14.0.3",
    "string-width": "^8.3.0",
    "tinyglobby": "^0.2.17",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.24.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "latest"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonbrito/brito.git"
  },
  "homepage": "https://github.com/wilsonbrito/brito#readme",
  "bugs": {
    "url": "https://github.com/wilsonbrito/brito/issues"
  },
  "author": "Wilson Brito",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/cli.bundle.mjs",
    ".brito/agents",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "llm",
    "knowledge-graph",
    "code-graph",
    "mcp",
    "claude",
    "tree-sitter",
    "svelte",
    "typescript",
    "python"
  ],
  "overrides": {
    "tar": "^7.5.22"
  }
}
